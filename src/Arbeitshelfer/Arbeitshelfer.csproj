<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <AssemblyName>Arbeitshelfer</AssemblyName>
    <RootNamespace>Arbeitshelfer</RootNamespace>
    <Version>0.10.0</Version>
    <Product>Arbeitshelfer</Product>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>info.ico</ApplicationIcon>
    <!-- DPI-Einstellung bleibt im Manifest, weil WPF sie dort braucht. -->
    <NoWarn>$(NoWarn);WFO0003</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <EmbeddedResource Include="info.ico" LogicalName="Arbeitshelfer.info.ico" />
    <Resource Include="info.ico" />
    <Resource Include="Symbole\*.png" />
  </ItemGroup>

  <ItemGroup>
    <!-- WinForms nur für das Infobereich-Symbol; keine globalen Usings, sonst Namenskonflikte mit WPF. -->
    <Using Remove="System.Windows.Forms" />
    <Using Remove="System.Drawing" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="System.Security.Cryptography.ProtectedData" Version="10.0.0" />
  </ItemGroup>

</Project>
